<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net9.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ApplicationManifest>app.manifest</ApplicationManifest>
    <NoWarn>NU1605</NoWarn>
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
    <Version>0.1.0</Version>
    <!-- Windows exe 图标（OrangeMushroom 多尺寸）；macOS .app 图标由打包脚本用 Assets/mac/AppIcon.icns -->
    <ApplicationIcon>Assets/app.ico</ApplicationIcon>
  </PropertyGroup>

  <!-- ====== NO_AI 纯净版（对外发布包）：-p:MiniPetNoAi=true ======
       定义 NO_AI 编译符号并从编译中剔除全部 AI 适配器 / AI 聊天窗 / AI 设置页，
       二进制内无任何 AI 功能（无网络连接、无文件监控），纯桌宠即开即用。
       代码侧配合：App/PetWindow.Menu/SettingsWindow 以 #if !NO_AI 挡住装配与 UI 入口。 -->
  <PropertyGroup Condition="'$(MiniPetNoAi)' == 'true'">
    <DefineConstants>$(DefineConstants);NO_AI</DefineConstants>
  </PropertyGroup>
  <ItemGroup Condition="'$(MiniPetNoAi)' == 'true'">
    <Compile Remove="Services/Adapters/**/*.cs" />
    <Compile Remove="Views/HermesChatWindow.cs" />
    <Compile Remove="Views/DshChatWindow.cs" />
    <Compile Remove="Views/SettingsWindow.Agent.cs" />
  </ItemGroup>

  <!-- ====== BASS 原生库拷贝目标判定（按目标平台而非构建机 OS）：
       macOS 上交叉发布 win-x64 时也必须拷 bass.dll（修复原 IsOSPlatform 条件交叉发布漏拷）。 ====== -->
  <PropertyGroup>
    <_BassForWindows Condition="'$(RuntimeIdentifier)' == 'win-x64' or '$(RuntimeIdentifier)' == 'win-x86' or '$(RuntimeIdentifier)' == 'win-arm64' or ('$(RuntimeIdentifier)' == '' and $([MSBuild]::IsOSPlatform('Windows')))">true</_BassForWindows>
    <_BassForMac Condition="'$(RuntimeIdentifier)' == 'osx-x64' or '$(RuntimeIdentifier)' == 'osx-arm64' or ('$(RuntimeIdentifier)' == '' and $([MSBuild]::IsOSPlatform('OSX')))">true</_BassForMac>
  </PropertyGroup>

  <ItemGroup>
    <RuntimeHostConfigurationOption Include="System.Drawing.EnableUnixSupport" Value="true" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Avalonia" Version="12.1.0" />
    <PackageReference Include="Avalonia.Desktop" Version="12.1.0" />
    <PackageReference Include="Avalonia.Themes.Fluent" Version="12.1.0" />
    <PackageReference Include="Avalonia.Fonts.Inter" Version="12.1.0" />
    <PackageReference Include="Microsoft.Extensions.DependencyInjection" Version="10.0.10" />
    <PackageReference Include="Microsoft.Data.Sqlite" Version="9.0.0" />
    <PackageReference Include="SkiaSharp" Version="3.119.0.0" />
    <PackageReference Include="System.Drawing.Common" Version="8.0.0" />
    <!-- 音乐模块 V0.2.0：ManagedBass 托管封装（原生 bass 库经下方 ItemGroup 按构建平台拷贝，见 ADR-0007） -->
    <PackageReference Include="ManagedBass" Version="3.1.1" />
  </ItemGroup>

  <ItemGroup>
    <Reference Include="WzComparerR2.WzLib">
      <HintPath>lib/WzComparerR2.WzLib.dll</HintPath>
    </Reference>
  </ItemGroup>

  <ItemGroup>
    <!-- 项目文档随编译产物分发：MiniPet/docs/** 复制到输出目录 -->
    <Content Include="docs/**/*.md">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
      <Link>docs/%(RecursiveDir)%(Filename)%(Extension)</Link>
    </Content>
  </ItemGroup>

  <ItemGroup>
    <!-- 托盘图标（状态栏）：随程序集内嵌（EmbeddedResource），运行时 TrayService 经清单流加载
         （Avalonia 12 已移除 AvaloniaLocator.Current，不走 AssetLoader） -->
    <EmbeddedResource Include="Assets/Slime.png" />
    <!-- 图标源文件 / ico / icns：不进二进制，随仓库分发供各平台打包脚本使用 -->
    <None Include="Assets/OrangeMushroom.png" />
    <None Include="Assets/app.ico" />
    <None Include="Assets/mac/AppIcon.icns" />
  </ItemGroup>

  <!-- ====== 音乐模块 V0.2.0：BASS 原生库按上方 _BassForWindows/_BassForMac 判定拷贝 ====== -->
  <ItemGroup>
    <None Include="lib/audio/libbass.dylib" Condition="'$(_BassForMac)' == 'true'">
      <Link>libbass.dylib</Link>
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </None>
    <None Include="lib/audio/bass.dll" Condition="'$(_BassForWindows)' == 'true'">
      <Link>bass.dll</Link>
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </None>
  </ItemGroup>

  <!-- ====== BASS 原生库哈希校验（ADR-0007：防闭源原生码静默替换；⚠️ 不能用 MSBuild 内置 Hash 任务——它哈希 item 字符串非文件内容） ====== -->
  <UsingTask TaskName="BassFileHash" TaskFactory="RoslynCodeTaskFactory"
             AssemblyFile="$(MSBuildToolsPath)\Microsoft.Build.Tasks.Core.dll">
    <ParameterGroup>
      <FilePath ParameterType="System.String" Required="true" />
      <Hash ParameterType="System.String" Output="true" />
    </ParameterGroup>
    <Task>
      <Using Namespace="System.IO" />
      <Using Namespace="System.Security.Cryptography" />
      <Code Type="Fragment" Language="cs">
        <![CDATA[
        using (var sha = SHA256.Create())
        using (var fs = System.IO.File.OpenRead(FilePath))
        {
            Hash = BitConverter.ToString(sha.ComputeHash(fs)).Replace("-", "").ToLowerInvariant();
        }
        ]]>
      </Code>
    </Task>
  </UsingTask>

  <Target Name="VerifyBassNativeBinaries" AfterTargets="Build">
    <ItemGroup>
      <BassNative Include="$(OutDir)libbass.dylib" Condition="Exists('$(OutDir)libbass.dylib')">
        <Expected>e81fb7b4d0009ba6343fbfcd840620704dcb840686d405b9734cd37150d31974</Expected>
      </BassNative>
      <BassNative Include="$(OutDir)bass.dll" Condition="Exists('$(OutDir)bass.dll')">
        <Expected>febb2cf1882d554c3a958280777da0b69f07de6e262df271de11c56e4a54afd4</Expected>
      </BassNative>
    </ItemGroup>
    <BassFileHash FilePath="%(BassNative.Identity)">
      <Output TaskParameter="Hash" PropertyName="BassActualHash" />
    </BassFileHash>
    <Error Condition="'$(BassActualHash)' != '' and '$(BassActualHash)' != '%(BassNative.Expected)'"
           Text="BASS 原生库哈希不匹配: %(BassNative.Identity) 期望 %(BassNative.Expected) 实际 $(BassActualHash) —— 疑似被替换，编译终止" />
  </Target>

  <Target Name="RemoveDuplicateAssemblyInfo" BeforeTargets="CoreCompile">
    <ItemGroup>
      <Compile Remove="obj/**/*AssemblyInfo.cs" />
      <Compile Remove="obj/**/*AssemblyAttributes.cs" />
    </ItemGroup>
  </Target>
</Project>