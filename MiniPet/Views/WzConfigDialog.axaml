<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        mc:Ignorable="d" d:DesignWidth="500" d:DesignHeight="280"
        x:Class="MiniPet.Views.WzConfigDialog"
        Title="WZ 配置"
        Width="500"
        Height="280"
        WindowStartupLocation="CenterOwner"
        CanResize="False"
        Background="{DynamicResource WindowBackground}">

    <Window.Resources>
        <SolidColorBrush x:Key="WindowBackground" Color="#1E1E26E0" />
        <SolidColorBrush x:Key="BorderBrush" Color="#50505A99" />
        <SolidColorBrush x:Key="AccentBrush" Color="#5E9CFF" />
        <SolidColorBrush x:Key="TextPrimaryBrush" Color="#F0F0F4" />
        <SolidColorBrush x:Key="TextSecondaryBrush" Color="#A0A0B0" />
        <SolidColorBrush x:Key="TextDimBrush" Color="#707080" />
        <SolidColorBrush x:Key="InputBackgroundBrush" Color="#1E1E24B3" />
        <SolidColorBrush x:Key="InputBorderBrush" Color="#78788C4D" />
        <SolidColorBrush x:Key="StatusGreenBrush" Color="#34C759" />
    </Window.Resources>

    <Grid RowDefinitions="Auto,*,Auto,28">
        <!-- 标题栏 -->
        <Border Grid.Row="0" Padding="12,0" Height="38"
               BorderBrush="{DynamicResource BorderBrush}"
               BorderThickness="0,0,0,1">
            <Grid ColumnDefinitions="Auto,*,Auto">
                <StackPanel Grid.Column="0" Orientation="Horizontal" Spacing="7">
                    <Ellipse Width="12" Height="12" Fill="#FF5F57" />
                    <Ellipse Width="12" Height="12" Fill="#FEBC2E" />
                    <Ellipse Width="12" Height="12" Fill="#28C840" />
                </StackPanel>
                <TextBlock Grid.Column="1" Text="📦 WZ 配置"
                          FontSize="13" FontWeight="SemiBold"
                          Foreground="{DynamicResource TextSecondaryBrush}"
                          HorizontalAlignment="Center"
                          VerticalAlignment="Center" />
                <Button Grid.Column="2" Background="Transparent"
                       BorderThickness="0" FontSize="14"
                       Foreground="{DynamicResource TextDimBrush}"
                       Click="OnCancelClick">
                    <TextBlock Text="✕" />
                </Button>
            </Grid>
        </Border>

        <!-- 内容主体 -->
        <StackPanel Grid.Row="1" Spacing="16" Padding="24,20" VerticalAlignment="Center">
            <!-- wzlib 路径 -->
            <StackPanel Spacing="5">
                <Grid ColumnDefinitions="*,Auto">
                    <TextBlock Grid.Column="0" Text="wzlib 路径"
                              FontSize="11" FontWeight="Medium"
                              Foreground="{DynamicResource TextSecondaryBrush}" />
                    <TextBlock Grid.Column="1" Text="WzComparerR2.WzLib.dll"
                              FontSize="9" Foreground="{DynamicResource TextDimBrush}" />
                </Grid>
                <Grid ColumnDefinitions="*,Auto" Spacing="8">
                    <TextBox x:Name="WzLibPathInput"
                            Watermark="选择 wzlib DLL…"
                            Text="" />
                    <Button Grid.Column="1" Content="浏览…"
                           Class="secondary" FontSize="10"
                           Height="28" Click="OnBrowseWzLibClick" />
                </Grid>
            </StackPanel>

            <!-- BaseWZ 路径 -->
            <StackPanel Spacing="5">
                <Grid ColumnDefinitions="*,Auto">
                    <TextBlock Grid.Column="0" Text="BaseWZ 路径"
                              FontSize="11" FontWeight="Medium"
                              Foreground="{DynamicResource TextSecondaryBrush}" />
                    <TextBlock Grid.Column="1" Text="Data 目录"
                              FontSize="9" Foreground="{DynamicResource TextDimBrush}" />
                </Grid>
                <Grid ColumnDefinitions="*,Auto" Spacing="8">
                    <TextBox x:Name="BaseWzPathInput"
                            Watermark="选择 Data 目录…"
                            Text="" />
                    <Button Grid.Column="1" Content="浏览…"
                           Class="secondary" FontSize="10"
                           Height="28" Click="OnBrowseBaseWzClick" />
                </Grid>
            </StackPanel>

            <!-- 按钮组 -->
            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Spacing="8">
                <Button Content="验证" Class="secondary" FontSize="11"
                       Click="OnValidateClick" />
                <Button Content="取消" Class="secondary" FontSize="11"
                       Click="OnCancelClick" />
                <Button Content="保存" Class="primary" FontSize="11"
                       Click="OnSaveClick" />
            </StackPanel>
        </StackPanel>

        <!-- 分隔线（占位） -->
        <Border Grid.Row="2" />

        <!-- 状态栏 -->
        <Border Grid.Row="3" Padding="14,0"
               BorderBrush="{DynamicResource BorderBrush}"
               BorderThickness="0,1,0,0">
            <Grid ColumnDefinitions="Auto,*,Auto">
                <Ellipse Grid.Column="0" Width="5" Height="5"
                        Fill="{DynamicResource StatusGreenBrush}"
                        VerticalAlignment="Center" />
                <TextBlock Grid.Column="1" x:Name="StatusText"
                          Text="wzlib 已加载 · BaseWZ 就绪"
                          FontSize="9" Foreground="{DynamicResource TextDimBrush}"
                          VerticalAlignment="Center" Margin="6,0,0,0" />
                <TextBlock Grid.Column="2" Text="v0.1"
                          FontSize="8" Foreground="#FFFFFF26"
                          FontFamily="monospace"
                          VerticalAlignment="Center" />
            </Grid>
        </Border>
    </Grid>
</Window>